// CI for the Rust (mmtorust) omc port, the full partest testsuite, and the
// WebAssembly/web deliverable.
//
//   build (parallel)
//     autoconf-jammy-gcc — a plain C/autotools build, only for the partest test
//                          harness bits (omc-diff, OMSI headers/libs, config.status)
//                          that makeLibsAndCache()/partest() expect at build/.
//     cmake-rust-gcc     — the omc port: a full native CMake build with the C++
//                          runtime and GUI clients ON (so partest can run), in the
//                          CI profile (-DRUST_OMC_CI=ON). Installs to build/ and
//                          also builds the wasm-jit runtime (rust_wasm_runtime),
//                          which is wasm-opt'd once here and handed to the web
//                          stage. Runs the cargo unit tests (ctest) in place,
//                          where the workspace is already compiled.
//
//   tests (parallel)
//     partest 1..3/3 — the full testsuite against the Rust omc (build/bin/omc).
//     web target     — the WebAssembly bundle (-DOM_OMC_WASM=ON) with
//                      -DRUST_OMC_WASM_RUNTIME=<stage-1 runtime.wasm> so the
//                      prebuilt runtime is embedded, not rebuilt. `make install`
//                      → <prefix>/share/omc/web, archived.
//
// Caching: only the cargo *registry* (downloaded packages) is cached, mounted at
// the image's CARGO_HOME/registry. The compiled target/ dir is NOT cached — with
// cargo incremental disabled (RUST_OMC_CI) it would not be reused (the build
// regenerates all .rs each run) and it fills the disk.
//
// The cmake-rust/web agents use the Rust image .CI/cache/rust/Dockerfile (the C
// build-deps image + nightly Rust toolchain, cranelift, wasm32, wasm-bindgen,
// binaryen); the autoconf/partest agents use the plain C image, as those steps
// need no Rust toolchain to build or run omc.
//
// TODO (deprecate autotools): the partest path still uses the autotools build —
// the autoconf-jammy-gcc stage (config.status + OMSI bits), common.makeLibsAndCache
// (`make libs-for-testing …` + generateTemplates) and common.partest (`make -C
// testsuite/difftool`). All of those test deps already exist as native CMake
// targets — omc-diff, libs-for-testing, reference-files, ffi-test-lib, aggregated
// as `testsuite-depends` — so this can become fully CMake-native: drop the
// autoconf stage, build `testsuite-depends` in the cmake-rust stage, and run
// runtests.pl directly against the cmake-built build/bin/omc + build/bin/omc-diff.
// The wrinkle to validate on a real run: each partest shard does
// standardSetup()/`git clean -ffdx`, which wipes the (untracked) built libraries,
// so the shard must rebuild libs-for-testing without the (unstashed) cmake build
// tree — e.g. by inlining its steps (`omc index.mos`). Left as a follow-up.

def common

pipeline {
  agent none
  options {
    buildDiscarder(logRotator(numToKeepStr: "15", artifactNumToKeepStr: "5"))
  }
  stages {
    stage('Environment') {
      agent {
        label '!windows'
      }
      steps {
        script {
          if (changeRequest()) {
            def buildNumber = env.BUILD_NUMBER as int
            if (buildNumber > 1) milestone(buildNumber - 1)
            milestone(buildNumber)
          }
          common = load("${env.workspace}/.CI/common.groovy")
        }
      }
    }

    stage('build') {
      parallel {
        // Plain C/autotools build — supplies the partest test-harness pieces
        // (omc-diff, OMSI bits, config.status) the same way the C cmake CI does.
        stage('autoconf-jammy-gcc') {
          agent {
            docker {
              image 'ghcr.io/openmodelica/build-deps:v1.22.3'
              label 'linux'
              alwaysPull true
              args "--mount type=volume,source=omlibrary-cache,target=/cache/omlibrary " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          steps {
            script { common.buildOMC('gcc', 'g++', '', true, false) }
            stash name: 'omc-gcc', includes: 'build/bin/OMCppOSUSimulation, build/include/omc/omsi/**, build/include/omc/omsic/**, build/lib/x86_64-linux-gnu/omc/omsi/**, build/lib/x86_64-linux-gnu/omc/omsicpp/**, **/config.status'
          }
        }

        // The Rust omc port: full native build (C++ runtime + GUI clients ON) so
        // partest can run, plus the wasm-jit runtime artifact for the web stage.
        stage('cmake-rust-gcc') {
          agent {
            dockerfile {
              additionalBuildArgs '--pull'
              dir '.CI/cache/rust'
              label 'linux'
              args "--mount type=volume,source=rust-cargo-registry,target=/opt/rust/cargo/registry " +
                   "--mount type=volume,source=omlibrary-cache,target=/cache/omlibrary " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          steps {
            script {
              common.standardSetup()
              sh """
                cmake -S . -B build_cmake \
                  -DCMAKE_BUILD_TYPE=Release \
                  -DOM_OMC_ENABLE_RUST=ON \
                  -DRUST_OMC_CI=ON \
                  -DOM_USE_CCACHE=OFF \
                  -DCMAKE_INSTALL_PREFIX=build \
                  -DRUST_OMC_WASM_RUNTIME_OUT=${env.WORKSPACE}/runtime.wasm
                cmake --build build_cmake --parallel ${common.numPhysicalCPU()} --target install
                cmake --build build_cmake --parallel ${common.numPhysicalCPU()} --target rust_wasm_runtime
                build/bin/omc --version
                ( cd build_cmake && ctest --output-on-failure --output-junit junit.xml )
              """
            }
            junit testResults: 'build_cmake/junit.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'runtime.wasm', fingerprint: true
            stash name: 'wasm-jit-runtime', includes: 'runtime.wasm'
            stash name: 'omc-cmake-rust', includes: 'build/**'
          }
        }
      }
    }

    stage('tests') {
      parallel {
        // The WebAssembly bundle, embedding the stage-1 wasm-jit runtime.
        stage('web target') {
          agent {
            dockerfile {
              additionalBuildArgs '--pull'
              dir '.CI/cache/rust'
              label 'linux'
              args "--mount type=volume,source=rust-cargo-registry,target=/opt/rust/cargo/registry " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          steps {
            script {
              common.standardSetup()
              unstash 'wasm-jit-runtime'
              sh """
                cmake -S . -B build_web \
                  -DCMAKE_BUILD_TYPE=Release \
                  -DOM_OMC_WASM=ON \
                  -DRUST_OMC_WASM_MODE=web-release \
                  -DRUST_OMC_WASM_RUNTIME=${env.WORKSPACE}/runtime.wasm \
                  -DOM_USE_CCACHE=OFF \
                  -DCMAKE_INSTALL_PREFIX=install_web
                cmake --build build_web --parallel ${common.numPhysicalCPU()}
                cmake --install build_web --component web
              """
            }
            archiveArtifacts artifacts: 'install_web/share/omc/web/**', fingerprint: true
          }
        }

        stage('partest 1/3') {
          agent {
            dockerfile {
              additionalBuildArgs '--pull'
              dir '.CI/cache'
              label 'linux'
              args "--mount type=volume,source=runtest-rust-cache,target=/cache/runtest " +
                   "--mount type=volume,source=omlibrary-cache,target=/cache/omlibrary " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          environment {
            RUNTESTDB = "/cache/runtest/"
            LIBRARIES = "/cache/omlibrary"
          }
          steps {
            script {
              common.standardSetup()
              unstash 'omc-gcc'
              unstash 'omc-cmake-rust'
              common.makeLibsAndCache()
              common.partest(1, 3)
            }
          }
        }
        stage('partest 2/3') {
          agent {
            dockerfile {
              additionalBuildArgs '--pull'
              dir '.CI/cache'
              label 'linux'
              args "--mount type=volume,source=runtest-rust-cache,target=/cache/runtest " +
                   "--mount type=volume,source=omlibrary-cache,target=/cache/omlibrary " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          environment {
            RUNTESTDB = "/cache/runtest/"
            LIBRARIES = "/cache/omlibrary"
          }
          steps {
            script {
              common.standardSetup()
              unstash 'omc-gcc'
              unstash 'omc-cmake-rust'
              common.makeLibsAndCache()
              common.partest(2, 3)
            }
          }
        }
        stage('partest 3/3') {
          agent {
            dockerfile {
              additionalBuildArgs '--pull'
              dir '.CI/cache'
              label 'linux'
              args "--mount type=volume,source=runtest-rust-cache,target=/cache/runtest " +
                   "--mount type=volume,source=omlibrary-cache,target=/cache/omlibrary " +
                   "-v /var/lib/jenkins/gitcache:/var/lib/jenkins/gitcache"
            }
          }
          environment {
            RUNTESTDB = "/cache/runtest/"
            LIBRARIES = "/cache/omlibrary"
          }
          steps {
            script {
              common.standardSetup()
              unstash 'omc-gcc'
              unstash 'omc-cmake-rust'
              common.makeLibsAndCache()
              common.partest(3, 3)
            }
          }
        }
      }
    }
  }
}
