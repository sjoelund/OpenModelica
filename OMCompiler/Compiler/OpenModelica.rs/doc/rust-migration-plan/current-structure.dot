digraph current_structure {
  graph [rankdir=TB, fontname="Helvetica", fontsize=14, nodesep=0.2, ranksep=0.5, newrank=true,
         label="Current crate structure of the Rust omc (build copy, 2026-11-18). Lines = generated + hand-written Rust.\nOrange = transpiled from MetaModelica by mmtorust, yellow = generated by Susan from *.tpl, green = hand-written, red outline = old frontend engine", labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [color="#777777", arrowsize=0.6];

  subgraph cluster_top {
    label="Entry points + scripting API (Main/, Script/, SimCode/SimCodeMain)"; style="rounded"; color="#888888";
    launcher [label="openmodelica\n(omc launcher)", fillcolor="#d9ead3"];
    cdylib [label="libopenmodelica_compiler\n(libOpenModelicaCompiler.so, 3k)", fillcolor="#d9ead3"];
    bmain [label="backend_main\nCevalScript*, Interactive, Main, SimCodeMain\n69k", fillcolor="#ffd8a8"];
    scrqt [label="scripting_qt\n(OMEdit C ABI, 13k)", fillcolor="#ffd8a8"];
    scru [label="script_util, program_util\n(4k)", fillcolor="#ffd8a8"];
  }

  subgraph cluster_codegen {
    label="Code generators"; style="rounded"; color="#888888";
    cg [label="codegen_c, codegen_cfunctions, codegen_cpp*,\ncodegen_fmu*, codegen_xml, codegen\n~250k (Susan, from 32 *.tpl)", fillcolor="#fff2a8"];
    tpl [label="tpl, codegen_util\n(Tpl runtime, 11k)", fillcolor="#ffd8a8"];
    wjit [label="codegen_wasm_jit, wasm_jit\n59k", fillcolor="#d9ead3"];
  }

  subgraph cluster_ob {
    label="Old backend (default)"; style="rounded"; color="#888888";
    ob [label="backend\nBackEnd/*, SimCodeUtil, HpcOm*\n277k", fillcolor="#ffd8a8"];
    obt [label="backend_types, backend_util,\nbackend_tools\n40k", fillcolor="#ffd8a8"];
  }
  subgraph cluster_nb {
    label="New backend (--newBackend)"; style="rounded"; color="#888888";
    nb [label="nbackend\nNBackEnd/*, NSimCode/*\n124k", fillcolor="#ffd8a8"];
  }
  subgraph cluster_sc {
    label="SimCode"; style="rounded"; color="#888888";
    sc [label="simcode_types, simcode_util\n13k", fillcolor="#ffd8a8"];
  }

  subgraph cluster_nf {
    label="New frontend (default)"; style="rounded"; color="#888888";
    nf [label="nf_frontend\nNFFrontEnd/* (84 packages)\n167k", fillcolor="#ffd8a8"];
    nfapi [label="nf_api\n(NFApi, 4k)", fillcolor="#ffd8a8"];
  }

  subgraph cluster_old {
    label="Old frontend engine (FrontEnd/Inst*, Lookup, Static, Ceval, Mod, ... + FFrontEnd/*)"; style="rounded"; color="#cc0000"; penwidth=2;
    of [label="frontend\n154k\nInst, Lookup, Static, Ceval, Mod,\nConnectUtil, InnerOuter, FGraph, FCore, ...", fillcolor="#ffd8a8", color="#cc0000", penwidth=2];
    ofi [label="frontend_inst\n1k", fillcolor="#ffd8a8", color="#cc0000", penwidth=2];
  }

  subgraph cluster_shared {
    label="Shared front-end data + utilities (FrontEnd/ — stays after the old frontend is gone)"; style="rounded"; color="#888888";
    fb [label="frontend_base\nExpression, ComponentReference,\nTypes, DAEUtil, Inline, ...\n69k (DAE utilities for OB/SimCode)", fillcolor="#ffd8a8"];
    fd [label="frontend_dump\nAbsynUtil, SCodeUtil, Dump,\nAbsynToSCode, ElementSource, ...\n55k", fillcolor="#ffd8a8"];
    ft [label="frontend_types\nDAE, SCode, Values, ClassInf\n8k", fillcolor="#ffd8a8"];
    ld [label="loader, ast_collections,\ndump_extra\n5k", fillcolor="#ffd8a8"];
  }

  subgraph cluster_found {
    label="Foundation"; style="rounded"; color="#888888";
    ast [label="ast\nAbsyn + hand-written Modelica parser\n12k", fillcolor="#d9ead3"];
    util [label="util\nFlags, Error, System, File, ...\n39k gen + 14k hand", fillcolor="#ffd8a8"];
    udb [label="util_datatypes_basic\nList, Array, ...\n8k gen + 5k hand", fillcolor="#ffd8a8"];
    mm [label="metamodelica (+ _derive)\nList, Array, Ref, GC,\nResult, builtins — 7k", fillcolor="#d9ead3"];
    err [label="error, wasi, lapack, fmi,\nzip, version, ...", fillcolor="#d9ead3"];
  }

  subgraph cluster_tools {
    label="Build tools (run during the build)"; style="rounded"; color="#888888";
    mmt [label="mmtorust\n49k", fillcolor="#d9ead3"];
    susan [label="susan, susan_index\n(susan: 24k transpiled)", fillcolor="#ffd8a8"];
    sag [label="scripting_api_gen", fillcolor="#d9ead3"];
  }

  simrt [label="OMCompiler/SimulationRuntime/rust\n(separate cargo workspace, 101k hand-written)\nsolvers, nls, daskr, result writers, sim_meta, ...", fillcolor="#d9ead3", shape=box3d];

  launcher -> cdylib -> bmain;
  cdylib -> scrqt; cdylib -> wjit;
  bmain -> cg; bmain -> ob; bmain -> nb; bmain -> nf; bmain -> nfapi; bmain -> of [color="#cc0000", penwidth=1.5]; bmain -> scru;
  cg -> tpl; cg -> sc;
  wjit -> sc; wjit -> simrt;
  ob -> obt; ob -> sc; ob -> nf; ob -> of [color="#cc0000", penwidth=1.5];
  sc -> of [color="#cc0000", penwidth=1.5, label="simcode_util", fontsize=8];
  nb -> nf; nb -> sc; nb -> fb;
  nfapi -> nf;
  nf -> fd; nf -> ft; nf -> util;
  of -> fb; of -> fd; of -> ofi; of -> ld;
  fb -> fd; fb -> ofi; fd -> ft; ft -> ast;
  ld -> fd;
  util -> udb -> mm; util -> err; ast -> mm;
  sc -> fb;
}
