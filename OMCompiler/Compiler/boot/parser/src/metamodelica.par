%start StoredDefinition
%title "MetaModelica Grammar"
%comment "Translated from metamodelica.g4 (ANTLR4) to Parol format"
%line_comment "//"
%block_comment "/*" "*/"

%%

// =============================================================================
// START SYMBOL
// =============================================================================

StoredDefinition
    : [ BOM ] [ WithinClause ";" ] ClassDefinitionList
    ;

WithinClause
    : "within" [ NamePath ]
    ;

ClassDefinitionList
    : { ("final"^ ClassDefinition ";" ) }
    ;

// =============================================================================
// CLASS DEFINITION
// =============================================================================

ClassDefinition
    : [ "encapsulated" ] [ "partial" ] ClassType ClassSpecifier
    ;

ClassType
    : "class"
    | "record"
    | "type"
    | "package"
    | [ "pure" | "impure" ] "function"
    | "uniontype"
    ;

Identifier
    : Ident
    | "equality"
    ;

ClassSpecifier
    : Identifier ClassSpecifier2
    | "extends" Identifier [ ClassModification ] StringComment Composition "end" Ident
    ;

ClassSpecifier2
    : [ "<"^ IdentList ">"^ ] StringComment Composition "end"^ Ident
    | "=" BasePrefix TypeSpecifier [ ClassModification ] Comment
    | "=" Enumeration
    | "subtypeof" TypeSpecifier
    ;

IdentList
    : Ident { "," Ident }
    ;

BasePrefix
    : TypePrefix
    ;

NameList
    : NamePath { "," NamePath }
    ;

// =============================================================================
// ENUMERATION
// =============================================================================

Enumeration
    : "enumeration" "(" [ EnumList | ":" ] ")" Comment
    ;

EnumList
    : EnumerationLiteral { "," EnumerationLiteral }
    ;

EnumerationLiteral
    : Ident Comment
    ;

// =============================================================================
// COMPOSITION
// =============================================================================

Composition
    : ElementList Composition2 [ "annotation" ";" ]
    ;

Composition2
    : [ ExternalClause ]
    | ( PublicElementList | ProtectedElementList | EquationClause | AlgorithmClause ) Composition2
    ;

ExternalClause
    : "external" [ LanguageSpecification ]
      [ [ ComponentReference "=" ] Ident "(" [ ExpressionList ] ")" [ Annotation ] ";" ]
    ;

PublicElementList
    : "public" ElementList
    ;

ProtectedElementList
    : "protected" ElementList
    ;

LanguageSpecification
    : String
    ;

ElementList
    : { ( Element | Annotation ) ";" }
    ;

Element
    : ImportClause
    | ExtendsClause
    | ("redeclare"^ "final"^ "inner"^ "outer"
       ( ( ClassDefinition | ComponentClause )
       | "replaceable" ( ClassDefinition | ComponentClause ) [ ConstrainingClause Comment ]
       )
     )
    ;

ImportClause
    : "import" ( ExplicitImportName | ImplicitImportName ) Comment
    ;

ExplicitImportName
    : Ident "=" NamePath
    ;

ImplicitImportName
    : NamePathStar
    ;

ExtendsClause
    : "extends" NamePath [ ClassOrInheritanceModification ] [ Annotation ]
    ;

ConstrainingClauseComment
    : ConstrainingClause Comment
    ;

ConstrainingClause
    : "extends" NamePath [ ClassModification ]
    | "constrainedby" NamePath [ ClassModification ]
    ;

ComponentClause
    : TypePrefix TypeSpecifier ComponentList
    ;

TypePrefix
    : [ "discrete" | "parameter" | "constant" ] [ "input" ] [ "output" ]
    ;

TypeSpecifier
    : NamePath [ "<"^ TypeSpecifierList ">"^ ] [ ArraySubscripts ]
    ;

TypeSpecifierNoDims
    : NamePath [ "<"^ TypeSpecifierList ">"^ ]
    ;

TypeSpecifierList
    : TypeSpecifier { "," TypeSpecifier }
    ;

ComponentList
    : ComponentDeclaration { "," ComponentList }
    ;

ComponentDeclaration
    : Declaration [ ConditionalAttribute ] Comment
    ;

ConditionalAttribute
    : "if" Expression
    ;

Declaration
    : [ ArraySubscripts ] [ Modification ]
    ;

Modification
    : ClassModification [ "=" ModificationExpression ]
    | "=" ModificationExpression
    | ":=" ModificationExpression
    ;

ModificationExpression
    : Expression
    | "break"
    ;

ClassModification
    : "(" [ ArgumentList ] ")"
    ;

ClassOrInheritanceModification
    : "(" [ ArgumentListInh ] ")"
    ;

ArgumentList
    : Argument { "," ArgumentList }
    ;

ArgumentListInh
    : ( Argument | InheritanceModification ) { "," ArgumentListInh }
    ;

InheritanceModification
    : "break" ( ConnectClause | Ident )
    ;

Argument
    : ElementModificationOrReplaceable
    | ElementRedeclaration
    ;

ElementModificationOrReplaceable
    : [ "each" ] [ "final" ] ( ElementModification | ElementReplaceable )
    ;

ElementModification
    : NamePath2 [ Modification ] StringComment
    ;

ElementRedeclaration
    : "redeclare" [ "each" ] [ "final" ]
      ( ( ClassDefinition | ComponentClause1 ) | ElementReplaceable )
    ;

ElementReplaceable
    : "replaceable" ( ClassDefinition | ComponentClause1 ) [ ConstrainingClause Comment ]
    ;

ComponentClause1
    : BasePrefix TypeSpecifierNoDims ComponentDeclaration1
    ;

ComponentDeclaration1
    : Declaration Comment
    ;

// =============================================================================
// EQUATION / ALGORITHM CLAUSES
// =============================================================================

EquationClause
    : "equation" EquationAnnotationList
    ;

EquationAnnotationList
    : { ( Equation | Annotation ) ";" }
    ;

AlgorithmClause
    : "algorithm" AlgorithmAnnotationList
    ;

AlgorithmAnnotationList
    : { ( Algorithm | Annotation ) ";" }
    ;

// =============================================================================
// EQUATIONS
// =============================================================================

Equation
    : ( EqualityOrNoretcallEquation | ConditionalEquationE | ForClauseE | ConnectClause
      | WhenClauseE | "failure" "(" Equation ")" | "equality" "(" Expression "=" Expression )
      Comment
    ;

EquationOrNoretcallEquation
    : SimpleExpression [ ("=" | ":=") Expression ]
    ;

ConditionalEquationE
    : "if" Expression "then" EquationList [ EquationElseifList ] [ "else" EquationList ] "end" "if"
    ;

ForClauseE
    : "for" ForIndices "loop" EquationList "end" "for"
    ;

EquationList
    : { Equation ";" }
    ;

EquationElseifList
    : EquationElseif { EquationElseif }
    ;

EquationElseif
    : "elseif" Expression "then" EquationList
    ;

EquationListThen
    : { Equation ";" }
    ;

// =============================================================================
// ALGORITHMS
// =============================================================================

Algorithm
    : ( AssignClauseA | ConditionalEquationA | ForClauseA | WhileClause
      | TryClause | WhenClauseA | "break" | "return" | "continue"
      | "failure" "(" Algorithm ")" | "equality" "(" Expression ":=" Expression )
      Comment
    ;

AssignClauseA
    : SimpleExpression [ ("=" | ":=") Expression ]
    ;

ConditionalEquationA
    : "if" Expression "then" AlgorithmList [ AlgorithmElseifList ] [ "else" AlgorithmList ] "end" "if"
    ;

ForClauseA
    : "for" ForIndices "loop" AlgorithmList "end" "for"
    ;

AlgorithmList
    : { Algorithm ";" }
    ;

AlgorithmElseifList
    : AlgorithmElseif { AlgorithmElseif }
    ;

AlgorithmElseif
    : "elseif" Expression "then" AlgorithmList
    ;

WhileClause
    : "while" Expression "loop" AlgorithmList "end" "while"
    ;

TryClause
    : "try" AlgorithmList "else" AlgorithmList "end" "try"
    ;

WhenClauseE
    : "when" Expression "then" EquationList { ElseWhenE } "end" "when"
    ;

ElseWhenE
    : "elsewhen" Expression "then" EquationList
    ;

WhenClauseA
    : "when" Expression "then" AlgorithmList { ElseWhenA } "end" "when"
    ;

ElseWhenA
    : "elsewhen" Expression "then" AlgorithmList
    ;

ConnectClause
    : "connect" "(" ComponentReference "," ComponentReference ")"
    ;

// =============================================================================
// EXPRESSIONS
// =============================================================================

Expression
    : IfExpression
    | SimpleExpression
    | MatchExpression
    | PartEvalFunctionExpression
    ;

PartEvalFunctionExpression
    : "pure" FunctionCall
    | "function" ComponentReference "(" [ NamedArguments ] ")"
    ;

IfExpression
    : "if" Expression "then" Expression { ElseifExpression } "else" Expression
    ;

ElseifExpression
    : "elseif" Expression "then" Expression
    ;

ForIndices
    : ForIndex { "," ForIndex }
    ;

ForIndex
    : Ident [ ("if" | "guard") Expression ] [ "in" Expression ]
    ;

SimpleExpression
    : SimpleExpr [ "::" SimpleExpression ]
    | Ident "as" SimpleExpression
    ;

SimpleExpr
    : LogicalExpression [ ":" LogicalExpression [ ":" LogicalExpression ] ]
    ;

LogicalExpression
    : LogicalTerm { "or" LogicalTerm }
    ;

LogicalTerm
    : LogicalFactor { "and" LogicalFactor }
    ;

LogicalFactor
    : [ "not" ] Relation
    ;

Relation
    : ArithmeticExpression
      [ ( Less | LessEq | Greater | GreaterEq | EqEq | LessGt ) ArithmeticExpression ]
    ;

ArithmeticExpression
    : UnaryArithmeticExpression { ("+" | "-" | ".+" | ".-") Term }
    ;

UnaryArithmeticExpression
    : ("+" | "-" | ".+" | ".-") Term
    | Term
    ;

Term
    : Factor { ("*" | "/" | ".*" | "./") Factor }
    ;

Factor
    : Primary [ ("^" | ".^") Primary ]
    ;

Primary
    : UnsignedInteger
    | UnsignedReal
    | String
    | "false"
    | "true"
    | ComponentReference__FunctionCall
    | "pure" FunctionCall
    | "(" [ OutputExpressionList ] [ ArraySubscripts ] ")"
    | "[" MatrixExpressionList "]"
    | "{" ForOrExpressionList "}"
    | "end"
    ;

MatrixExpressionList
    : ExpressionList { ";" ExpressionList }
    ;

ComponentReference__FunctionCall
    : ComponentReference "<"^ NameList ">" FunctionCall
    | ComponentReference [ FunctionCall ] [ "."^ Expression ]
    ;

// =============================================================================
// NAME PATHS
// =============================================================================

NamePathEnd
    : NamePath
    ;

NamePath
    : [ "." ] NamePath2
    ;

NamePath2
    : Ident [ "." NamePath2 ]
    ;

NamePathStar
    : Ident [ ".*" | "." "{" NamePathGroup "}" | "." NamePathStar ]
    ;

NamePathGroup
    : Ident [ "=" Ident ] [ "," NamePathGroup ]
    ;

ComponentReferenceEnd
    : ComponentReference
    ;

ComponentReference
    : [ "." ] ComponentReference2
    | "__"
    | "_"
    ;

ComponentReference2
    : Ident [ ArraySubscripts ] [ "." ComponentReference2 ]
    ;

FunctionCall
    : "(" FunctionArguments ")"
    ;

FunctionArguments
    : ForOrExpressionList [ NamedArguments ]
    ;

ForOrExpressionList
    : [ Expression { "," Expression } [ "threaded" ForIndices ] ]
    ;

NamedArguments
    : NamedArgument { "," NamedArgument }
    ;

NamedArgument
    : Ident "=" Expression
    ;

OutputExpressionList
    : [ Expression ] { "," [ Expression ] }
    ;

ExpressionList
    : Expression { "," Expression }
    ;

// =============================================================================
// ARRAY SUBSCRIPTS
// =============================================================================

ArraySubscripts
    : "[" Subscript { "," Subscript } "]"
    ;

Subscript
    : Expression
    | ":"
    ;

// =============================================================================
// COMMENTS / ANNOTATIONS
// =============================================================================

Comment
    : StringComment [ Annotation ]
    ;

StringComment
    : [ String { "+" String } ]
    ;

Annotation
    : "annotation" ClassModification
    ;

// =============================================================================
// MATCH EXPRESSIONS
// =============================================================================

MatchExpression
    : "matchcontinue" Expression StringComment [ LocalClause ] Cases "end" "matchcontinue"
    | "match" Expression StringComment [ LocalClause ] Cases "end" "match"
    ;

LocalClause
    : [ "local" ElementList ]
    ;

Cases
    : OneCase Cases2
    ;

Cases2
    : OneCase Cases2
    | "else" StringComment [ LocalClause ]
      [ "equation" EquationListThen | "algorithm" AlgorithmAnnotationList ]
      "then" Expression ";"
    |
    ;

OneCase
    : "case" Pattern [ ("if" | "guard") Expression ] StringComment [ LocalClause ]
      [ "equation" EquationListThen | "algorithm" AlgorithmAnnotationList ]
      "then" Expression ";"
    ;

Pattern
    : Expression
    ;

// =============================================================================
// TERMINALS (Lexer Rules)
// =============================================================================
//
// Order matters: keywords defined before Ident so that same-length matches
// prioritize keywords over the general identifier pattern (longest-match first,
// then declaration-order for ties).
// Multi-character operators defined before single-character ones.
//

// --- Multi-character operators (longest first) ---

Assign     : ":="     ;
ColonColon : "::"     ;
LessEq     : "<="     ;
LessGt     : "<>"     ;
GreaterEq  : ">="     ;
EqEq       : "=="     ;
PlusEw     : ".+"     ;
MinusEw    : ".-"     ;
StarEw     : ".*"     ;
SlashEw    : "./"     ;
PowerEw    : ".^"     ;

// --- Single-character operators / punctuation ---

Dot     : "."  ;
Lparen  : "("  ;
Rparen  : ")"  ;
Lbrack  : "["  ;
Rbrack  : "]"  ;
Lbrace  : "{"  ;
Rbrace  : "}"  ;
Equals  : "="  ;
Comma   : ","  ;
Colon   : ":"  ;
Semicolon: ";" ;
Mod     : "%"  ;
Star    : "*"  ;
Minus   : "-"  ;
Plus    : "+"  ;
Less    : "<"  ;
Greater : ">"  ;
Power   : "^"  ;
Slash   : "/"  ;

// --- Wildcards (before Ident for same-length priority) ---

AllWild : "__" ;
Wild    : "_"  ;

// --- Keywords (before Ident for same-length priority) ---

T_Algorithm   : "algorithm"   ;
T_And         : "and"         ;
T_Annotation  : "annotation"  ;
T_As          : "as"          ;
T_Break       : "break"       ;
T_Case        : "case"        ;
T_Class       : "class"       ;
T_Connect     : "connect"     ;
T_Connector   : "connector"   ;
T_Constant    : "constant"    ;
T_Constraint  : "constraint"  ;
T_Constrainedby : "constrainedby" ;
T_Continue    : "continue"    ;
T_Discrete    : "discrete"    ;
T_Each        : "each"        ;
T_Else        : "else"        ;
T_Elseif      : "elseif"      ;
T_Elsewhen    : "elsewhen"    ;
T_Encapsulated: "encapsulated";
T_End         : "end"         ;
T_Enumeration : "enumeration" ;
T_Equation    : "equation"    ;
T_Equality    : "equality"    ;
T_Expandable  : "expandable"  ;
T_Extends     : "extends"     ;
T_External    : "external"    ;
T_False       : "false"       ;
T_Failure     : "failure"     ;
T_Final       : "final"       ;
T_Field       : "field"       ;
T_Flow        : "flow"        ;
T_For         : "for"         ;
T_Function    : "function"    ;
T_Guard       : "guard"       ;
T_If          : "if"          ;
T_Import      : "import"      ;
T_Impure      : "impure"      ;
T_In          : "in"          ;
T_Inner       : "inner"       ;
T_Input       : "input"       ;
T_Local       : "local"       ;
T_Loop        : "loop"        ;
T_Match       : "match"       ;
T_Matchcontinue: "matchcontinue";
T_Not         : "not"         ;
T_Or          : "or"          ;
T_Outer       : "outer"       ;
T_Output      : "output"      ;
T_Package     : "package"     ;
T_Parallel    : "parallel"    ;
T_Parameter   : "parameter"   ;
T_Partial     : "partial"     ;
T_Protected   : "protected"   ;
T_Public      : "public"      ;
T_Pure        : "pure"        ;
T_Record      : "record"      ;
T_Redecare    : "redeclare"   ;
T_Replaceable : "replaceable" ;
T_Return      : "return"      ;
T_Stream      : "stream"      ;
T_Subtypeof   : "subtypeof"   ;
T_Then        : "then"        ;
T_Threaded    : "threaded"    ;
T_True        : "true"        ;
T_Try         : "try"         ;
T_Type        : "type"        ;
T_Uniontype   : "uniontype"   ;
T_When        : "when"        ;
T_While       : "while"       ;
T_Within      : "within"      ;

// --- Data tokens ---

Bom
    : /\xEF\xBB\xBF/
    ;

Ident
    : /(?:[\$_a-zA-Z][\$_a-zA-Z0-9]*|\$cpuTime|'(?:[^'\\]|\\.)*')/
    ;

String
    : /"(?:[^"\\]|\\['"\\?abfnrtv])*"/
    ;

UnsignedReal
    : /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?|[0-9]+([eE][+-]?[0-9]+)|\.[0-9]+([eE][+-]?[0-9]+)?/
    ;

UnsignedInteger
    : /[0-9]+/
    ;

