// name: arrayLiteralZero
// keywords: NewBackend
// status: correct
// An array equation with zeros in an array literal is split, so the zero
// elements do not make an algebraic loop.

loadString("
model ArrayLiteralZero
  constant Real c[2] = {1, 0};
  Real x, y[2];
equation
  y = c * x;
  x = sin(time) + exp(-y[2]);
end ArrayLiteralZero;
"); getErrorString();
setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
simulate(ArrayLiteralZero); getErrorString();
val(x, 1.0);
