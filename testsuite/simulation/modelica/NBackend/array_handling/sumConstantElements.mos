// name: sumConstantElements
// keywords: NewBackend
// status: correct
// Constant elements of an array, also through aliases of elements, are
// replaced in sum(), so the other factors of their terms do not make an
// algebraic loop.

loadString("
model SumConstantElement
  Real x, f[2], h[2];
equation
  f = {1, 0} * time;
  h = {time, x};
  x = sin(time) + exp(-sum(f .* h));
end SumConstantElement;
model SumConstantFor
  Real x[3], f[3, 2], g[3, 2], h[3, 2];
equation
  for i in 1:3 loop
    f[i] = {1, 0} * time;
    g[i, 1] = -f[i, 1];
    g[i, 2] + f[i, 2] = 0;
    h[i] = {time, x[i]};
    x[i] = sin(time) + exp(-sum(g[i] .* h[i]));
  end for;
end SumConstantFor;
"); getErrorString();
setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
simulate(SumConstantElement); getErrorString();
val(x, 1.0);
simulate(SumConstantFor); getErrorString();
val(x[2], 1.0);
