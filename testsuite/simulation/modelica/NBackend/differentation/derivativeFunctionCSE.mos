// name: derivativeFunctionCSE
// keywords: NewBackend
// status: correct
// Repeated calls in a differentiated function are computed once (h), but not
// outside the if-branch (f) or the reduction (g) that contains them.

loadString("
package DerCSE
  function f
    input Real x;
    output Real y;
  algorithm
    y := if x > 0 then log(x)/sqrt(x) else x;
    annotation(Inline = false);
  end f;

  function g
    input Real x[3];
    output Real y;
  algorithm
    y := sum(x[i]/sqrt(x[i]^2 + 1) for i in 1:3);
    annotation(Inline = false);
  end g;

  function h
    input Real x;
    output Real y;
  algorithm
    y := x/sqrt(x^2 + 1);
    annotation(Inline = false);
  end h;

  model M
    Real z(start = -1);
    Real w[3](each start = 1);
    Real v(start = 1);
  equation
    f(z) + z^3 = -2 - time;
    for i in 1:3 loop
      g(w) + w[i]^3 = i + time;
    end for;
    h(v) + v^3 = 2 + time;
  end M;
end DerCSE;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(DerCSE.M); getErrorString();
val(z, 1);
val(w[2], 1);
val(v, 1);
