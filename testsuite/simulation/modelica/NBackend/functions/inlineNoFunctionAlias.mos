// name: inlineNoFunctionAlias
// keywords: NewBackend
// status: correct
// A call of a function with Inline = true is inlined where it is used. It
// gets no function alias variable.

loadString("
model InlineNoFunctionAlias
  function poly
    input Real x;
    input Real c[3];
    output Real y;
  algorithm
    y := c[1] + x*(c[2] + x*c[3]);
    annotation(Inline = true);
  end poly;

  parameter Real c[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real x = 1 + time;
  Real y[3];
equation
  for i in 1:3 loop
    y[i] = poly(x, c[i, :]) - poly(1, c[i, :]);
  end for;
end InlineNoFunctionAlias;
"); getErrorString();
setCommandLineOptions("--newBackend -d=dumpCSE"); getErrorString();
simulate(InlineNoFunctionAlias); getErrorString();
val(y[2], 1);
// Result:
// true
// ""
// true
// ""
