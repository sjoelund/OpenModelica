// name: arrayStartIterationVars
// keywords: NewBackend, initialization, start, array
// status: correct
// cflags: --newBackend
//
// The start value equation of an array, $START.x = p, sets the values of x too.
// Newton then starts from p, also for iteration variables that are slices of x.

loadString("
package ArrayStartGuess
  model WholeArray
    parameter Real p[3] = {1.5, -1.5, 2};
    Real x[3](start = p);
  equation
    for i in 1:3 loop
      x[i]^3 - x[i] = time;
    end for;
  end WholeArray;

  model Slice
    parameter Real p[4] = {9, 1.5, -1.5, 2};
    Real x[4](start = p);
  equation
    x[1] = time;
    for i in 2:4 loop
      x[i]^3 - x[i] = time;
    end for;
  end Slice;

  model Matrix
    parameter Real p[2,2] = [1.5, -1.5; 2, -2];
    Real x[2,2](start = p);
  equation
    for i in 1:2, j in 1:2 loop
      x[i,j]^3 - x[i,j] = time;
    end for;
  end Matrix;
end ArrayStartGuess;
"); getErrorString();

simulate(ArrayStartGuess.WholeArray, stopTime = 0); getErrorString();
{val(x[1], 0), val(x[2], 0), val(x[3], 0)};
simulate(ArrayStartGuess.Slice, stopTime = 0); getErrorString();
{val(x[2], 0), val(x[3], 0), val(x[4], 0)};
simulate(ArrayStartGuess.Matrix, stopTime = 0); getErrorString();
{val(x[1,1], 0), val(x[1,2], 0), val(x[2,1], 0), val(x[2,2], 0)};

