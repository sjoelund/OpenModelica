// name: lambda0Simplify
// keywords: NewBackend, initialization, homotopy, simplify
// status: correct
//
// In the lambda=0 system, homotopy(y, 0.0) becomes 0.0. The equations are
// simplified after that, so x*0.0 does not make an algebraic loop.

loadString("
model Lambda0Simplify
  Real x, y, z;
equation
  z + x*homotopy(y, 0.0) = 1;
  x = sin(z) + time;
  y = x*z;
end Lambda0Simplify;
"); getErrorString();
setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
simulate(Lambda0Simplify, stopTime = 0); getErrorString();
{val(x, 0), val(y, 0), val(z, 0)};
