// name: lambda0Tearing
// keywords: NewBackend, initialization, homotopy, initialSimplified, tearing
// status: correct
//
// At lambda = 0, initialSimplified() selects the forward equations, so the
// lambda = 0 system of Backward is the one of Forward. Its tearing must be
// the same as for Forward (residual v2.b.w + ...) and must not depend on the
// initialization system with lambda > 0, which is a different problem.

loadString("
impure function initialSimplified
  discrete output Boolean isInitialSimplified;
  external \"builtin\";
end initialSimplified;

package Lambda0Twin
  connector Flange
    flow Real w;
    Real p;
  end Flange;

  model Valve
    parameter Real dpNom = 1e5;
    parameter Real wNom;
    Flange a(w(start = wNom)), b;
    input Real opening;
  equation
    a.w + b.w = 0;
    a.w = homotopy(opening*wNom*sqrt(abs(a.p - b.p)/dpNom)*sign(a.p - b.p), opening*wNom/dpNom*(a.p - b.p));
  end Valve;

  model Source
    parameter Real p;
    Flange port;
  equation
    port.p = p;
  end Source;

  model FlowSensor
    Flange a, b;
    output Real w;
  equation
    a.w + b.w = 0;
    a.p = b.p;
    w = a.w;
  end FlowSensor;

  model Network
    parameter Boolean forward = true;
    parameter Real u0 = 0.5, w0 = 1.2;
    parameter Real u(fixed = false), wCalc(fixed = false);
    Source src(p = 3e5), sink(p = 1e5);
    Valve v1(wNom = 1, opening = u), v2(wNom = 2, opening = 1), v3(wNom = 1, opening = 1);
    FlowSensor fs;
  initial equation
    if initialSimplified() or forward then
      u = u0;
      wCalc = fs.w;
    else
      fs.w = w0;
      wCalc = w0;
    end if;
  equation
    connect(src.port, v1.a);
    connect(v1.b, v2.a);
    connect(v1.b, v3.a);
    connect(v2.b, fs.a);
    connect(v3.b, fs.a);
    connect(fs.b, sink.port);
  end Network;

  model Forward = Network(forward = true);
  model Backward = Network(forward = false);
end Lambda0Twin;
"); getErrorString();
setCommandLineOptions("--newBackend --allowNonStandardModelica=initialSimplified -d=tearingdump"); getErrorString();
translateModel(Lambda0Twin.Backward); getErrorString();
