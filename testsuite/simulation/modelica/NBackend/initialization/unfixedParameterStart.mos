// name: unfixedParameterStart
// keywords: NewBackend, initialization, start, parameter
// status: correct
// cflags: --newBackend
//
// The start value of a parameter with fixed = false is the initial guess when
// the parameter is an iteration variable, also when the start is not a literal.

loadString("
model UnfixedParamStart
  parameter Real p0 = 1.5;
  parameter Real p(start = p0, fixed = false);
  parameter Real q[2](start = {p0, -p0}, each fixed = false);
initial equation
  p^3 - p = 0;
  for i in 1:2 loop
    q[i]^3 - q[i] = 0;
  end for;
end UnfixedParamStart;
"); getErrorString();

simulate(UnfixedParamStart, stopTime = 0); getErrorString();
{val(p, 0), val(q[1], 0), val(q[2], 0)};

