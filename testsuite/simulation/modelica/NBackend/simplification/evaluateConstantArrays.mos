// name: evaluateConstantArrays
// keywords: NewBackend
// status: correct
// suite: cSources
// teardown_command: rm -rf EvaluateConstantArrays*
// Constant array subexpressions are evaluated after tearing, also in the
// Jacobian of the algebraic loop. The generated equations have no fill().

loadString("
model EvaluateConstantArrays
  Real x(start = 1);
  Real y[3];
equation
  y = x * (fill(1.0, 3) * 2 + {1, 2, 3}) .^ 2;
  x^3 + sum(y) = 30 + time;
end EvaluateConstantArrays;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(EvaluateConstantArrays); getErrorString();
val(x, 1);
val(y[3], 1);
system("grep -c 'fill(' EvaluateConstantArrays_info.json", outputFile = "EvaluateConstantArrays_cnt.txt"); getErrorString();
readFile("EvaluateConstantArrays_cnt.txt");
