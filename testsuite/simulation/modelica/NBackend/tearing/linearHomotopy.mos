// name: linearHomotopy
// keywords: NewBackend, tearing, linear, homotopy
// status: correct
//
// A linear loop with homotopy() is a linear system, also in the initial
// system. HomotopyLinear then has no nonlinear system that needs homotopy.
// In HomotopyNonlinear, the global homotopy solves the linear system for
// each lambda.

loadString("
model HomotopyLinear
  Real x, y;
equation
  x + homotopy(2*y, 3*y) = 1;
  3*x - y = cos(time);
end HomotopyLinear;

model HomotopyNonlinear
  Real x, y, z(start = 2);
equation
  x + homotopy(2*y, 3*y) = 1;
  3*x - y = cos(time);
  z^3 + z = homotopy(4 + x*z, 4);
end HomotopyNonlinear;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(HomotopyLinear); getErrorString();
{val(x, 0), val(y, 0), val(x, 1), val(y, 1)};
simulate(HomotopyNonlinear); getErrorString();
{val(x, 0), val(y, 0), val(z, 0), val(z, 1)};
// Result:
// true
// ""
// true
