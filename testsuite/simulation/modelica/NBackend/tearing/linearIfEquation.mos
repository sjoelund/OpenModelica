// name: linearIfEquation
// keywords: NewBackend, tearing, linear, if-equation
// status: correct
//
// A loop with if-equations is linear if every branch is linear in the
// iteration variables. It is solved as a linear system.

loadString("
model IfEquationLoop
  Real x, y;
  Real u[2], v[2];
equation
  if time > 0.5 then
    x + 2*y = 1;
  else
    x + 3*y = 1;
  end if;
  3*x - y = cos(time);
  for i in 1:2 loop
    if time > 0.5 then
      u[i] + 2*v[i] = i;
    else
      u[i] + 3*v[i] = i;
    end if;
    3*u[i] - v[i] = sin(time);
  end for;
end IfEquationLoop;
"); getErrorString();
setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
simulate(IfEquationLoop); getErrorString();
{val(x, 0.25), val(y, 0.25), val(x, 1), val(y, 1)};
{val(u[2], 0.25), val(v[2], 0.25), val(u[2], 1), val(v[2], 1)};
