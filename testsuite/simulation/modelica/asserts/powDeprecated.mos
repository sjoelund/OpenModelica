// name: powDeprecated
// status: correct
//
// MLS 10.6.7: raising a negative base to a Real exponent with an integer value
// is deprecated. It warns once per site, and is an error with --strict.
// Integer exponents are not affected.

loadString("
package PowDeprecated
  function realPow
    input Real base;
    input Real exponent;
    output Real y = base^exponent;
  end realPow;

  model M
    parameter Real a = 2;
    parameter Integer n = 3;
    Real x = 0.5 - time;
    Real y = x^a;
    Real yf = realPow(x, a);
    Real z = x^n;
    Real dz = der(z);
    Real w = x^(n - 1);
  annotation(experiment(StopTime = 1));
  end M;

  model Strict
    parameter Real x = -1;
    parameter Real a = 2;
    Real y = x^a;
  end Strict;
end PowDeprecated;
"); getErrorString();

simulate(PowDeprecated.M); getErrorString();
val(y, 1.0);
val(yf, 1.0);
val(z, 1.0);
val(w, 1.0);

setCommandLineOptions("--strict"); getErrorString();
simulate(PowDeprecated.Strict); getErrorString();

