// name: negativeNominal
// keywords: nonlinear nominal scaling
// status: correct
// teardown_command: rm -f NegativeNominal*
//
// x starts at 0 and has a negative nominal. The solvers scale by the nominal,
// which must not give a scale factor of 0 and an iteration variable of NaN.

loadString("
model NegativeNominal
  Real x(start = 0, nominal = -2);
equation
  x + x^3 = -10;
end NegativeNominal;
"); getErrorString();

simulate(NegativeNominal, stopTime = 0); getErrorString();
val(x, 0);
simulate(NegativeNominal, stopTime = 0, simflags = "-nls=hybrid"); getErrorString();
val(x, 0);

