// name: EventClockTimeEvent
// keywords: synchronous event clock time event
// status: correct
//
// A time event between two output points fires the event clock.

loadString("
model EventClockTimeEvent
  Real trig = if time < 0.502 then 1 else 0.2;
  Clock clk = Clock(trig < 0.4);
  Real y = sample(time, clk);
annotation(experiment(StopTime=1, Interval=0.01));
end EventClockTimeEvent;
"); getErrorString();
simulate(EventClockTimeEvent); getErrorString();
val(y, 0.505);
val(y, 1.0);

